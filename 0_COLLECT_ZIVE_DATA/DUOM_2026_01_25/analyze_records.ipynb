  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# ECG Record Summaries (standalone)\n",
    "\n",
    "Uses the helper functions from `analyze_ecg_zip_structure_refactoring2.py` to scan a folder of JSON+signal files, summarize each record, save to CSV, and print one row per record."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from pathlib import Path\n",
    "import sys\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "\n",
    "# adjust if running from a different working directory\n",
    "PROJECT_ROOT = Path.cwd()\n",
    "CODE_PATH = PROJECT_ROOT / \"0_COLLECT_ZIVE_DATA\"\n",
    "sys.path.append(str(CODE_PATH))\n",
    "\n",
    "import analyze_ecg_zip_structure_refactoring2 as analyzer\n",
    "\n",
    "# --- parameters ---\n",
    "DATA_DIR = PROJECT_ROOT / \"DATA_ORIG\"  # change to the folder containing sequence subfolders\n",
    "FS = 256  # sampling frequency Hz"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def find_data_file(json_path: Path) -> Path | None:\n",
    "    \"\"\"Return the matching data file for a given JSON (same stem).\"\"\"\n",
    "    stem = json_path.stem\n",
    "    rec_dir = json_path.parent\n",
    "    # priority: .npy, .bin, then any three-digit extension\n",
    "    candidates = [\n",
    "        rec_dir / f\"{stem}.npy\",\n",
    "        rec_dir / f\"{stem}.bin\",\n",
    "    ]\n",
    "    candidates += sorted([p for p in rec_dir.glob(f\"{stem}.*\") if p.suffix[1:].isdigit() and len(p.suffix) == 4])\n",
    "    for p in candidates:\n",
    "        if p.exists():\n",
    "            return p\n",
    "    return None\n",
    "\n",
    "\n",
    def sample_count(path: Path, ext: str) -> int:\n",
    "    ext = ext.lower()\n",
    "    if ext == \".npy\":\n",
    "        arr = np.load(path, mmap_mode=\"r\", allow_pickle=False)\n",
    "        return int(getattr(arr, \"size\", 0))\n",
    "    # .bin or any three-digit extension -> 4 bytes per sample\n",
    "    return int(path.stat().st_size // 4)\n",
    "\n",
    "\n",
    def load_json(path: Path):\n",
    "    return analyzer._safe_json_load_path(path)\n",
    "\n",
    "\n",
    def file_size(path: Path) -> int:\n",
    "    return path.stat().st_size\n",
    "\n",
    "\n",
    def infer_sequence_id(json_path: Path) -> str:\n",
    "    # expected layout: <seq>/recordings/<id>.json\n",
    "    return json_path.parent.parent.name if json_path.parent.name == \"recordings\" else json_path.parent.name"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# collect all JSON metadata files under DATA_DIR\n",
    "json_files = sorted(DATA_DIR.rglob(\"*.json\"))\n",
    "records = []\n",
    "\n",
    "for jp in json_files:\n",
    "    data_path = find_data_file(jp)\n",
    "    if data_path is None:\n",
    "        print(f\"WARN: no data file found for {jp}\")\n",
    "        continue\n",
    "\n",
    "    seq_id = infer_sequence_id(jp)\n",
    "    rec_id = jp.stem\n",
    "    rec, rec_dict = analyzer.summarize_record(\n",
    "        sequence_id=seq_id,\n",
    "        recording_id=rec_id,\n",
    "        json_ref=jp,\n",
    "        data_ref=data_path,\n",
    "        data_ext=data_path.suffix,\n",
    "        load_json_fn=load_json,\n",
    "        file_size_fn=file_size,\n",
    "        sample_count_fn=sample_count,\n",
    "        fs=FS,\n",
    "    )\n",
    "    records.append(rec_dict)\n",
    "\n",
    "df = pd.DataFrame(records)\n",
    "csv_path = DATA_DIR / \"records_summary.csv\"\n",
    "df.to_csv(csv_path, index=False)\n",
    "\n",
    "print(f\"Saved {len(df)} records to {csv_path}\")\n",
    "for _, row in df.iterrows():\n",
    "    print(row.to_dict())"
   ]
  }
 ],
